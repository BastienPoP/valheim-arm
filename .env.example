# Copy to .env, then edit. Docker Compose reads .env automatically.
#   cp .env.example .env

# Server password. At least 5 characters, and it must NOT appear inside
# SERVER_NAME. Leave empty for a server with no password.
SERVER_PASSWORD=changeme

# Name shown in the server browser.
SERVER_NAME=Valheim

# World name. A world that does not exist yet is created on first start.
SERVER_WORLD=Dedicated

# 0 = unlisted, players join by IP. 1 = listed in the community server browser.
SERVER_PUBLIC=0
